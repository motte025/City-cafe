#!/bin/sh
set -eu

# GitHub Pages liefert index.html mit Cache-Control: max-age=600. Chromiums
# eigener Festplatten-Cache ueberlebt Prozess-Neustarts, also wuerde ein
# Neustart innerhalb dieser 10 Minuten trotzdem den alten Stand zeigen. Der
# Zeitstempel macht die URL bei jedem Start neu, damit immer frisch geladen wird.
CACHEBUST="$(date +%s)"

# --disable-site-isolation-trials ist raus: es sparte auf dem ODROID (2 GB)
#   Speicher, blendet in neueren Chromium-Fassungen aber eine Warnleiste ein.
# --disable-background-networking / -sync / -default-apps und die Features
#   unten: Hintergrunddienste eines normalen Desktop-Browsers (Uebersetzer,
#   Casting, Vorschlags-Downloads, Sync), die am Fernseher niemand braucht,
#   die aber Speicher und CPU belegen.
#   BackForwardCache: der Kiosk navigiert nie zurueck; die alte Seite im
#   Speicher zu halten, waere reine Verschwendung.
# --app statt --kiosk: unter sway darf Chromium nicht im Vollbild stehen (sonst
# laege es ueber dem mpv-Fenster des Nightlife-Slots). --kiosk ohne Vollbild
# blendet Tabs und Adressleiste ein, --app zeigt nur die Seite.
# CITYCAFE_CHROMIUM_EXTRA: zusaetzliche Schalter je Geraet (nur Schalter ohne
# Leerzeichen), z. B. auf dem x86-Rechner mit AMD-Grafik
#   CITYCAFE_CHROMIUM_EXTRA="--enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL"
# Auf dem ODROID leer lassen. CITYCAFE_OUTPUT: Name des Bildschirmausgangs
# (Standard HDMI-A-1; auf dem W1 mit `swaymsg -t get_outputs` nachsehen).
OUTPUT="${CITYCAFE_OUTPUT:-HDMI-A-1}"
# CITYCAFE_URL: andere Dashboard-Adresse (Test auf der Box, z. B.
#   http://127.0.0.1:8090/index.html), Standard GitHub Pages.
# CITYCAFE_URL_EXTRA: weitere Parameter fuer die Adresse, mit "&" davor - hier
#   steht z. B. "&chefpin=1234" (YouTube-Musik: der TV ist Chef). Nur in
#   ~/.config/citycafe.env, nie im Repo.
# CITYCAFE_RAUM / CITYCAFE_BOXNAME: welcher Screen das ist. Standard ist der
# Fernseher zuhause; im Cafe CITYCAFE_RAUM=city-cafe (dort kein Roulette-Spiel,
# nur die Werbung). Boxname leer = das Dashboard nimmt "City Cafe".
RAUM="${CITYCAFE_RAUM:-zuhause}"
BOXNAME="${CITYCAFE_BOXNAME-Zuhause}"
# Erweiterungen nur laden, wenn sie auf dem Geraet liegen (nicht im Repo).
EXT=""
for e in /opt/citycafe/twitch-autostart /opt/citycafe/h264-force /opt/citycafe/youtube-kiosk-ui; do
  if [ -d "$e" ]; then EXT="${EXT:+$EXT,}$e"; fi
done
# Ein 4K-Desktop macht Browser-Video ohne Hardware-Decoder unnoetig teuer.
wlr-randr --output "$OUTPUT" --mode 1920x1080@60Hz || true
# shellcheck disable=SC2086
exec chromium \
  ${CITYCAFE_CHROMIUM_EXTRA:-} \
  --ozone-platform=wayland \
  ${EXT:+--load-extension=$EXT} \
  --app="${CITYCAFE_URL:-https://motte025.github.io/City-cafe/}?kiosk=1&raum=${RAUM}${BOXNAME:+&boxname=$BOXNAME}${CITYCAFE_URL_EXTRA:-}&_t=${CACHEBUST}" \
  --disable-features=Translate,MediaRouter,OptimizationHints,AutofillServerCommunication,BackForwardCache \
  --disable-background-networking \
  --disable-sync \
  --disable-default-apps \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --autoplay-policy=no-user-gesture-required \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --user-data-dir=/home/citycafe/.config/chromium-kiosk
